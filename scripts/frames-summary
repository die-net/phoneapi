#!/usr/bin/env python3
"""Summarize a `screenrecord --output-format=frames` file: frame count, size, and mean brightness."""

import json
import struct
import sys

path = sys.argv[1]
frames = []
with open(path, "rb") as f:
    while True:
        header = f.read(20)
        if len(header) < 20:
            break
        packet_len, width, height, stride, fmt = struct.unpack("<5I", header)
        data = f.read(packet_len - 16)
        if len(data) < packet_len - 16:
            frames.append({"truncated": True})
            break
        # Every 97th pixel is plenty to tell a black frame from a real one.
        step = 3 * 97
        samples = [
            (0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2])
            for i in range(0, len(data) - 2, step)
        ]
        frames.append(
            {"width": width, "height": height, "mean_luma": round(sum(samples) / max(len(samples), 1), 1)}
        )
print(json.dumps({"file": path, "frames": len(frames), "first_frames": frames[:5]}))
